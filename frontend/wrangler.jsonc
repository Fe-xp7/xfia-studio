{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xfia-sites",
  "main": "worker.js",
  "compatibility_date": "2025-08-23",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
