PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/site-factory
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
CLIENT_URL=http://localhost:5173
# Em produção, aceite mais de uma origem separando por vírgulas.
CLIENT_URLS=http://localhost:5173

# Use "mock" para desenvolvimento local ou "http" para um provedor real.
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_MODEL=

DEPLOYMENT_PROVIDER=local
PUBLIC_SITE_URL=http://localhost:5173
# Use "path" sem domínio próprio e "subdomain" com domínio wildcard.
PUBLIC_SITE_MODE=path
# Produção: sites.xfiatech.com / https. Local: slug.localhost:5173 / http.
PUBLIC_SITE_BASE_DOMAIN=localhost:5173
PUBLIC_SITE_SCHEME=http
DEFAULT_CREATION_FEE=500
DEFAULT_MONTHLY_FEE=50

# Use "local" no computador e "cloudinary" no Render gratuito.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Use "mock" em desenvolvimento e "asaas" após configurar o Sandbox.
BILLING_PROVIDER=mock
ASAAS_API_URL=https://api-sandbox.asaas.com
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=troque-por-um-token-aleatorio-com-32-ou-mais-caracteres
