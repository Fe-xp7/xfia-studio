PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/site-factory
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=8h
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=troque-esta-senha
CLIENT_URL=http://localhost:5173
# Em produção, aceite mais de uma origem separando por vírgulas.
CLIENT_URLS=http://localhost:5173

# Use "mock" para desenvolvimento local ou "http" para um provedor real.
AI_PROVIDER=mock
AI_API_URL=
AI_API_KEY=
AI_MODEL=

DEPLOYMENT_PROVIDER=local
PUBLIC_SITE_URL=http://localhost:5173
DEFAULT_CREATION_FEE=500
DEFAULT_MONTHLY_FEE=50

# Use "local" no computador e "cloudinary" no Render gratuito.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
