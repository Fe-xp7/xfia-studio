{
  "name": "gerador-de-sites",
  "private": true,
  "version": "1.0.0",
  "engines": { "node": ">=20" },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend run start",
    "seed:admin": "npm --prefix backend run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
